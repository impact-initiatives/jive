msgid "jmmi_data_validator.data_issues"
msgstr "{count} column values failed validation. Check output for details."

msgid "jmmi_data_validator.data_issues.invalid_country.issue"
msgstr "{column} should be 3 uppercase letters."

msgid "jmmi_data_validator.data_issues.invalid_round.issue"
msgstr "'{main_column}' must start with '{start_column}', contain '{contain_column}' and end with '{end_column}'."

msgid "empty_column_validator.empty_values"
msgstr "{count} column values were empty when values were expected. Check output for details."

msgid "skip_logic_validator.failed_conversions"
msgstr "{count} skip logic expressions could not be evaluated. Check output for details."

msgid "skip_logic_validator.invalid_values"
msgstr "{count} column values did not match the skip logic for the column. Check output for details."

